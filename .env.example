# Streamline Environment Variables Example
# Copy this file to .env when configuring local services

# Application Ports & URLs
PORT=3000
API_PORT=4000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Authentication & Security
# Generate a cryptographically secure 256-bit secret for production: openssl rand -base64 32
JWT_SECRET=streamline_dev_secret_key_needs_to_be_at_least_32_characters_long_min_256_bits
JWT_ISSUER=streamline
JWT_AUDIENCE=streamline-app
ACCESS_TOKEN_EXPIRES_IN=10m
REFRESH_TOKEN_EXPIRES_DAYS=30
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Local Infrastructure (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=streamline
POSTGRES_PORT=5434
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/streamline?schema=public

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Object Storage (MinIO / S3 - planned upcoming milestones)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=streamline-media

# MediaMTX (planned upcoming milestones)
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_WEBRTC_URL=http://localhost:8889
MEDIAMTX_RTMP_URL=rtmp://localhost:1935
MEDIAMTX_HLS_URL=http://localhost:8888
