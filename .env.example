# Streamline Environment Variables Example
# Copy this file to .env when configuring local services

# Application Ports & URLs
PORT=3000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Local Infrastructure (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=streamline
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/streamline?schema=public

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Object Storage (MinIO / S3 - planned upcoming milestones)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=streamline-media

# MediaMTX (planned upcoming milestones)
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_WEBRTC_URL=http://localhost:8889
MEDIAMTX_RTMP_URL=rtmp://localhost:1935
MEDIAMTX_HLS_URL=http://localhost:8888
