# StreamLine Environment Variables Example
# Copy this file to .env or .env.local when configuring services

# Server & Ports
PORT=3000
API_PORT=4000

# Database
DATABASE_URL=

# Redis
REDIS_URL=

# Object Storage (MinIO / S3)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=

# MediaMTX
MEDIAMTX_API_URL=
MEDIAMTX_RTMP_URL=
MEDIAMTX_HLS_URL=
